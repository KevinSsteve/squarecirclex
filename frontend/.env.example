# AWS Cognito Configuration
# Get these values from AWS CloudFormation outputs after deploying the backend
# Run: aws cloudformation describe-stacks --stack-name experta-ai-social-manager --query 'Stacks[0].Outputs'
VITE_USER_POOL_ID=us-east-1_XXXXXXXXX
VITE_USER_POOL_CLIENT_ID=XXXXXXXXXXXXXXXXXXXXXXXXXX

# API Configuration
# This is the API Gateway URL from CloudFormation outputs
VITE_API_URL=https://xxxxxxxxxx.execute-api.us-east-1.amazonaws.com/dev

# AWS Region
VITE_AWS_REGION=us-east-1
