# AWS Cognito Configuration
# Get these values from AWS CloudFormation outputs after deploying the backend
# Run: aws cloudformation describe-stacks --stack-name experta-ai-social-manager --query 'Stacks[0].Outputs'
VITE_USER_POOL_ID=us-east-1_XXXXXXXXX
VITE_USER_POOL_CLIENT_ID=XXXXXXXXXXXXXXXXXXXXXXXXXX

# API Configuration
# This is the API Gateway URL from CloudFormation outputs
VITE_API_URL=https://xxxxxxxxxx.execute-api.us-east-1.amazonaws.com/dev

# AWS Region
VITE_AWS_REGION=us-east-1

# Development Mode Configuration
# Set to 'true' to enable development mode features
# 
# When enabled:
# - Skips brand association check in GameView
# - Allows access to /app without completing onboarding
# - Shows development mode warning banner
# - Handles backend errors gracefully when no brand exists
#
# IMPORTANT: 
# - Should be 'true' for local development
# - MUST be 'false' for production deployments
# - Automatically disabled in production builds regardless of this setting
#
# Default: false (safe default)
VITE_DEV_MODE=false
